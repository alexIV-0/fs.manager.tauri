{
	// Node-скрипты сборки jsx (esbuild + fs/promises + process). Отдельная программа,
	// чтобы они НЕ попадали в ExtendScript-проект (jsx/tsconfig.json), где noLib:true и
	// нет @types/node — там они бы не скомпилировались.
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ESNext"],
		"types": ["node"],
		"typeRoots": ["../../node_modules/@types"],
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["**/*.js", "**/*.ts"],
	"exclude": ["node_modules"]
}
